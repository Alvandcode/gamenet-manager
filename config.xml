<?xml version='1.0' encoding='utf-8'?>
<widget id="com.alvand.gamenet.manager" version="1.1.0" 
        xmlns="http://www.w3.org/ns/widgets" 
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    
    <name>Gamenet Manager Alvand</name>
    <description>مدیریت گیم‌نت الوند</description>
    <author href="https://github.com/Alvandcode">Alvandcode</author>
    
    <content src="index.html" />

    <engine name="android" spec="^13.0.0" />
    
    <!-- دسترسی شبکه فقط برای لینک‌های اشتراک‌گذاری؛ همه asset ها آفلاین داخل برنامه‌اند -->
    <allow-intent href="https://*/*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="tg:*" />
    <allow-intent href="whatsapp:*" />
    <allow-intent href="rubika:*" />
    
    <preference name="Orientation" value="default" />
    <preference name="BackgroundColor" value="#FF0F0C29" />
    <preference name="Fullscreen" value="false" />
    
    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
    </platform>
    
</widget>
